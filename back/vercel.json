{
  "version": 2,
  "builds": [
    {
      "src": "./index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "./index.js",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
      {
  "headers": [
    {
      "source": "/products",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://mern-shop-seven-pi.vercel.app"
        }
      ]
    }
  ]
}
    }
  ]
}
